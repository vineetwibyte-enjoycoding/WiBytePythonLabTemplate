{
  "name": "WiByte Python Lab",
  "build": {
    "dockerfile": "Dockerfile"
  },

  "containerEnv": {
    "DISPLAY": ":1"
  },

  // ==============================================================================
  // PORT FORWARDING & VISIBILITY
  // Port 6080 is explicitly marked PUBLIC to bypass browser third-party cookie
  // and OAuth restrictions (especially on Chromebooks and school networks).
  // ==============================================================================
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Desktop (noVNC)",
      "onAutoForward": "notify",
      "visibility": "public"
    }
  },

  // ==============================================================================
  // PROCESS MANAGEMENT
  // Boots supervisord on container startup, resume, or restart.
  // ==============================================================================
  "postStartCommand": "supervisord -c /workspaces/${localWorkspaceFolderBasename}/.devcontainer/supervisord.conf &",

  // ==============================================================================
  // CODESPACES INFRASTRUCTURE & RESOURCE CONFIGURATION
  // 1. Fixed idle timeout to 10 minutes to auto-shutdown abandoned sessions.
  // 2. Pins container hardware specs (2 cores, 4GB RAM) for predictable execution.
  // ==============================================================================
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "32gb"
  },
 
  // ==============================================================================
  // VS CODE ENVIRONMENT & EXTENSIONS
  // ==============================================================================
  "customizations": {
    "vscode": {
      "extensions": [
        "github.copilot",
        "ms-python.python"
      ],
      "settings": {
        "security.workspace.trust.enabled": false,
        "python.defaultInterpreterPath": "/usr/local/bin/python3",
        "files.exclude": {
          "**/*.dist-info": true,
          "**/colorama": true,
          "**/pyfiglet": true,
          "**/*.pyc": true,
          "**/__pycache__": true
        },
        "editor.lightbulb.enabled": "off",
        "github.copilot.editor.enableCodeActions": false,
        "editor.suggestOnTriggerCharacters": true,
        "editor.parameterHints.enabled": true,
        "workbench.startupEditor": "readme"
      }
    }
  }
}