{
  "name": "WiByte Python Lab",
  "build": {
    "dockerfile": "Dockerfile"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "github.copilot",
        "ms-python.python"
      ],
      "settings": {
        // Points the VS Code "Play" button directly to the single Python binary
        "python.defaultInterpreterPath": "/usr/local/bin/python3",

        // Hides background package folders from the student file panel
        "files.exclude": {
          "**/*.dist-info": true,
          "**/colorama": true,
          "**/pyfiglet": true,
          "**/*.pyc": true,
          "**/__pycache__": true
        },

        // Pedagogy settings: disables automatic code actions/lightbulbs
        "editor.lightbulb.enabled": "off",
        "github.copilot.editor.enableCodeActions": false,

        // Standard coding aids (IntelliSense) stay active
        "editor.suggestOnTriggerCharacters": true,
        "editor.parameterHints.enabled": true,

        // Ensures the README is the first thing students see
        "workbench.startupEditor": "readme"
      }
    }
  },
  "remoteUser": "root"
}
  
 
 
